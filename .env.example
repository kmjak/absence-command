# 環境変数の中身はdummyです。
# 実際の値は.envに記載してください。

# 学生ポータルのURL
STUDENT_PORTAL_URL=https://example.com

# 学生ポータルのPHPSESSID（application/session）
# `scripts/session.sh`（`/absence setup` からも実行される）がログイン時に自動で取得して
# この行を書き換えるため、ブラウザの開発者ツールから手動でコピーする必要はありません。
STUDENT_PORTAL_PHPSESSID=example_session_id

# 学生ポータルのログイン情報
STUDENT_PORTAL_USER_ID=your_student_id
STUDENT_PORTAL_PASSWORD=your_password
